# Copiar a .env (ignorado por git) para sobreescribir localmente.
# Valores por defecto no sensibles, sólo para desarrollo local (constitution.md §4).

# Postgres de desarrollo (docker-compose service "db", puerto 5432)
POSTGRES_USER=valuacion
POSTGRES_PASSWORD=valuacion

# Postgres de test manual (docker-compose service "db-test", puerto 5433)
POSTGRES_TEST_USER=valuacion_test
POSTGRES_TEST_PASSWORD=valuacion_test
